<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.35"
            android:text="EDITH"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            style="@style/Card"
            android:layout_marginTop="16dp"
            android:text="Stopped"
            android:textColor="@color/accent_light"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/micLevel"
            style="@style/Hint"
            android:fontFamily="monospace"
            android:visibility="gone" />

        <Button
            android:id="@+id/toggle"
            style="@style/BigButton"
            android:text="Start listening for “Edith”" />

        <Button
            android:id="@+id/askNow"
            style="@style/SmallButton"
            android:text="Ask now (without wake word)" />

        <Button
            android:id="@+id/meetingToggle"
            style="@style/SmallButton"
            android:text="Start Meeting mode" />

        <TextView
            android:id="@+id/heard"
            style="@style/Hint"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lastQa"
            style="@style/Hint"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true" />

        <!-- ===== Headphones ===== -->
        <TextView style="@style/Section" android:text="My headphones" />

        <TextView
            android:id="@+id/headphoneStatus"
            style="@style/Hint"
            android:textColor="@color/accent_light" />

        <Button
            android:id="@+id/registerHeadphones"
            style="@style/SmallButton"
            android:text="Register my headphones" />

        <CheckBox
            android:id="@+id/headphoneLock"
            style="@style/Radio"
            android:text="Only work when my registered headphones are connected" />

        <TextView
            style="@style/Hint"
            android:text="EDITH pauses (microphone off) whenever your headphones are not connected, and resumes by itself when they are. To use other headphones, pair them with the phone, then register them here." />

        <!-- ===== Personality & voice ===== -->
        <TextView style="@style/Section" android:text="EDITH's voice &amp; hearing" />

        <TextView style="@style/Label" android:text="EDITH calls you" />
        <EditText
            android:id="@+id/address"
            style="@style/Input"
            android:hint="sir"
            android:inputType="textCapWords" />

        <Button
            android:id="@+id/phoneVoice"
            style="@style/SmallButton"
            android:text="🗣 Choose EDITH's voice (on this phone)" />

        <TextView
            android:id="@+id/speedLabel"
            style="@style/Label"
            android:text="Speed" />
        <SeekBar
            android:id="@+id/speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/pitchLabel"
            style="@style/Label"
            android:text="Pitch" />
        <SeekBar
            android:id="@+id/pitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="70" />

        <TextView
            style="@style/Hint"
            android:text="More voices: Android Settings → System → Languages → Text-to-speech → Speech Services by Google → ⚙ → Install voice data → English (India)." />

        <CheckBox
            android:id="@+id/humanVoice"
            style="@style/Radio"
            android:text="Groq studio voice instead (uses Groq quota; phone voice is used when the limit is reached)" />

        <RadioGroup
            android:id="@+id/voiceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/vHannah" style="@style/Radio" android:text="Hannah (female)" />
            <RadioButton android:id="@+id/vDiana" style="@style/Radio" android:text="Diana (female)" />
            <RadioButton android:id="@+id/vAutumn" style="@style/Radio" android:text="Autumn (female)" />
            <RadioButton android:id="@+id/vDaniel" style="@style/Radio" android:text="Daniel (male)" />
            <RadioButton android:id="@+id/vAustin" style="@style/Radio" android:text="Austin (male)" />
            <RadioButton android:id="@+id/vTroy" style="@style/Radio" android:text="Troy (male)" />
        </RadioGroup>

        <Button
            android:id="@+id/testVoice"
            style="@style/SmallButton"
            android:text="▶ Test voice" />

        <TextView style="@style/Label" android:text="Words EDITH should recognise (names, places, brands)" />
        <EditText
            android:id="@+id/extraWords"
            style="@style/Input"
            android:hint="e.g. Harsha, Indiranagar, Supabase, Rahul Sharma"
            android:inputType="text" />

        <Button
            android:id="@+id/hearingTest"
            style="@style/SmallButton"
            android:text="🎧 Hearing test (see what EDITH hears)" />

        <TextView
            style="@style/Hint"
            android:text="Tip: Bluetooth earbud microphones send call-quality audio. If EDITH mishears you, choose “Phone microphone” in section 3." />

        <!-- ===== Server ===== -->
        <TextView style="@style/Section" android:text="1 · Your EDITH server" />

        <TextView style="@style/Label" android:text="Server address" />
        <EditText
            android:id="@+id/serverUrl"
            style="@style/Input"
            android:hint="https://edith-ai-xxxx.onrender.com"
            android:inputType="textUri" />

        <TextView style="@style/Label" android:text="EDITH password (OWNER_ACCESS_TOKEN)" />
        <EditText
            android:id="@+id/password"
            style="@style/Input"
            android:hint="the password you use on the website"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/test"
            style="@style/SmallButton"
            android:text="Test connection" />

        <!-- ===== Wake word ===== -->
        <TextView style="@style/Section" android:text="2 · Wake word" />

        <TextView
            style="@style/Hint"
            android:text="Say “Edith” or “Hey Edith”, wait for the beep, then ask. Wake-word detection runs offline on this phone: no account, nothing sent until you say it." />

        <CheckBox
            android:id="@+id/conversationMode"
            style="@style/Radio"
            android:text="Keep listening after “Edith” for follow-up questions and tasks (Conversation mode). Side conversations are ignored; ends after 2 minutes without a question, or say “stop listening”." />

        <CheckBox
            android:id="@+id/strictWake"
            style="@style/Radio"
            android:text="Only wake when “Edith” is said on its own (recommended: fewer false wake-ups)" />

        <!-- ===== Microphone ===== -->
        <TextView style="@style/Section" android:text="3 · Microphone" />

        <RadioGroup
            android:id="@+id/micSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/micHeadset"
                style="@style/Radio"
                android:text="Headphone microphone (when connected)" />
            <RadioButton
                android:id="@+id/micPhone"
                style="@style/Radio"
                android:text="Phone microphone (better music quality and battery)" />
        </RadioGroup>
        <TextView
            style="@style/Hint"
            android:text="Using the headphone mic keeps Bluetooth in “call mode”: music sounds like a phone call and the headphone battery drains faster." />

        <CheckBox
            android:id="@+id/mediaButton"
            style="@style/Radio"
            android:text="Headphone play/pause button also asks EDITH (may take over music controls)" />

        <!-- ===== Phone control ===== -->
        <TextView style="@style/Section" android:text="4 · Phone control" />

        <TextView
            style="@style/Hint"
            android:text="Say “Edith, call Mom”, “open Instagram”, “play Kesariya by Arijit Singh on Spotify”, “WhatsApp Rahul saying I’ll be late”, “email Priya saying the proposal is ready”, “find me leads for dentists in Indiranagar”, “pause”, “set an alarm for 6 AM”, “navigate to the airport”." />

        <TextView
            android:id="@+id/phoneStatus"
            style="@style/Hint"
            android:textColor="@color/accent_light" />

        <Button
            android:id="@+id/allowCalls"
            style="@style/SmallButton"
            android:text="Allow calls (contacts + phone)" />

        <Button
            android:id="@+id/testCall"
            style="@style/SmallButton"
            android:text="📞 Test call (shows exactly what fails)" />

        <TextView
            android:id="@+id/aliases"
            style="@style/Hint" />

        <Button
            android:id="@+id/clearAliases"
            style="@style/SmallButton"
            android:text="Forget remembered contact choices" />

        <Button
            android:id="@+id/allowApps"
            style="@style/SmallButton"
            android:text="Allow opening apps &amp; music (display over other apps)" />

        <Button
            android:id="@+id/allowWhatsApp"
            style="@style/SmallButton"
            android:text="Allow typing &amp; Send in apps (full edition)" />

        <TextView
            style="@style/Hint"
            android:text="If Android says the setting is restricted: open App info for EDITH → ⋮ (top right) → “Allow restricted settings”, then try again." />

        <Button
            android:id="@+id/appInfo"
            style="@style/SmallButton"
            android:text="Open EDITH App info" />

        <TextView style="@style/Label" android:text="Country code for WhatsApp (numbers saved without +)" />
        <EditText
            android:id="@+id/countryCode"
            style="@style/Input"
            android:hint="91"
            android:inputType="number" />

        <Button
            android:id="@+id/brandPopups"
            style="@style/SmallButton"
            android:text="Xiaomi / Redmi / POCO / Oppo / Vivo / Realme: allow pop-ups from background" />

        <TextView style="@style/Label" android:text="Recent actions" />
        <TextView
            android:id="@+id/actionLog"
            style="@style/Hint"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:text="Nothing yet" />

        <TextView style="@style/Label" android:text="My favourite music" />
        <EditText
            android:id="@+id/favoriteMusic"
            style="@style/Input"
            android:hint="e.g. Liked Songs, Arijit Singh, lo-fi beats"
            android:inputType="text" />

        <TextView style="@style/Label" android:text="Music app" />
        <RadioGroup
            android:id="@+id/musicApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/musicSpotify" style="@style/Radio" android:text="Spotify" />
            <RadioButton android:id="@+id/musicYtMusic" style="@style/Radio" android:text="YouTube Music" />
            <RadioButton android:id="@+id/musicJioSaavn" style="@style/Radio" android:text="JioSaavn" />
        </RadioGroup>

        <!-- ===== About me ===== -->
        <TextView style="@style/Section" android:text="5 · About me" />

        <TextView
            style="@style/Hint"
            android:text="Tell EDITH who you are. It remembers this and uses it in every answer, email and meeting reply. One fact per line." />

        <EditText
            android:id="@+id/aboutMe"
            style="@style/Input"
            android:gravity="top"
            android:hint="My name is Harsha.\nI run a web design agency in Bangalore.\nI build websites for small businesses.\nMy email signature: Harsha, Founder"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="4"
            android:singleLine="false" />

        <Button
            android:id="@+id/saveAboutMe"
            style="@style/SmallButton"
            android:text="Save “About me”" />

        <Button
            android:id="@+id/battery"
            style="@style/SmallButton"
            android:text="Allow EDITH to run in background (battery settings)" />

        <TextView
            style="@style/Hint"
            android:layout_marginTop="16dp"
            android:text="While EDITH listens, a notification is shown. Sound is analysed on this phone for the wake word; only your question after “Edith” is sent to your server. First start takes a few seconds to prepare the offline speech model." />
    </LinearLayout>
</ScrollView>
