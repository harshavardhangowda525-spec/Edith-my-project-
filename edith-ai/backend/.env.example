# =====================================================================
# EDITH AI backend configuration. Copy to .env and fill in real values.
# NEVER commit .env. These keys stay on the server - never in frontend code.
# =====================================================================

ENVIRONMENT=development          # development | production | test
LOG_LEVEL=INFO

# ---- AI provider ------------------------------------------------------
# mock      -> offline canned replies, clearly labeled "[Mock mode]"
# openai    -> any OpenAI-compatible /chat/completions API
#              (OpenAI, OpenRouter, Groq, Together, Ollama, LM Studio, ...)
# anthropic -> Anthropic Messages API (dedicated adapter)
# groq | openrouter | together | deepseek | mistral | gemini | ollama | lmstudio
#           -> OpenAI-compatible services; address and a default model are filled in
AI_PROVIDER=mock
AI_API_KEY=your-ai-api-key-here
# Optional - leave blank to use the provider's address and default model
AI_BASE_URL=
AI_MODEL=
# Comma-separated models users may choose in Settings (AI_MODEL is always allowed)
AI_ALLOWED_MODELS=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=600
AI_TEMPERATURE=0.4
# Example Anthropic setup:
#   AI_PROVIDER=anthropic
#   AI_BASE_URL=https://api.anthropic.com/v1
#   AI_MODEL=claude-sonnet-5-5
# Example local Ollama (no key needed by Ollama, but set any placeholder):
#   AI_PROVIDER=openai
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_API_KEY=ollama
#   AI_MODEL=llama3.1

# ---- Server-side speech-to-text (used by the Android app) ----------------
# auto -> use the AI provider's Whisper (groq or openai) with AI_API_KEY
SPEECH_PROVIDER=auto             # auto | groq | openai | none
SPEECH_API_KEY=
SPEECH_BASE_URL=                 # blank = provider default
STT_MODEL=                       # blank = whisper-large-v3 (groq) / whisper-1 (openai)
TTS_MODEL=                       # blank = canopylabs/orpheus-v1-english (groq) / tts-1 (openai)
TTS_VOICE=                       # blank = hannah (groq: autumn diana hannah austin daniel troy) / alloy (openai)

# ---- Authentication ----------------------------------------------------
# local    -> dev-only static tokens below (refused when ENVIRONMENT=production)
# personal -> one owner + one long secret password (for your online deployment)
# supabase -> verify Supabase Auth access tokens
AUTH_MODE=local
# personal mode: password >= 24 random characters; OWNER_USER_ID = your Supabase user UID
OWNER_ACCESS_TOKEN=
OWNER_USER_ID=
# token:user-id pairs. Generate a token with:  py -c "import secrets;print(secrets.token_urlsafe(32))"
LOCAL_ACCESS_TOKENS=change-me-dev-token:00000000-0000-0000-0000-000000000001

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Lead finder (Google Places API (New); see docs/LEADS_AND_EMAIL.md) ----
GOOGLE_MAPS_API_KEY=

# ---- Email: Gmail send-only with an App password (never reads the inbox) --
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_SENDER_NAME=

# ---- Speed: model routing (see docs/PERFORMANCE.md) ----------------------
# auto: quick questions -> fast model, coding -> AI_MODEL, hard problems -> deep model. off: always AI_MODEL.
AI_ROUTING=auto
AI_MODEL_FAST=                   # empty = provider default (Groq: llama-3.1-8b-instant)
AI_MODEL_DEEP=                   # empty = provider default (Groq: openai/gpt-oss-120b)
ROUTE_TIMEOUT_FAST=12
ROUTE_TIMEOUT_BALANCED=30
ROUTE_TIMEOUT_DEEP=60
# Optional cost estimate in /api/metrics: USD per 1M tokens [input, output] per model, as JSON.
# AI_PRICES_PER_MTOK={"llama-3.1-8b-instant": [0.05, 0.08]}

# ---- GitHub intelligence (optional, read-only token is enough) ---------
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=             # owner/name used for "check my GitHub"

# ---- Background tasks & PC bridge --------------------------------------
TASK_WORKERS=3
BRIDGE_JOB_TIMEOUT_S=900
BRIDGE_WAKE_WAIT_S=240          # how long to wait for a sleeping laptop to wake up
LOG_FORMAT=text                  # text | json

# ---- Storage -----------------------------------------------------------
STORAGE_BACKEND=memory           # memory (lost on restart) | supabase

# ---- Security ----------------------------------------------------------
# Folder with the built frontend to serve from "/" (set automatically in the Docker image)
# STATIC_DIR=../frontend/dist
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=1048576
