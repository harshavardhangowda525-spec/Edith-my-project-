# Frontend config. ONLY public values belong here - Vite inlines VITE_* into the bundle.
# Never put an AI API key or Supabase service-role key in this file.
VITE_API_URL=http://localhost:8000

# Optional: enable Supabase email/password sign-in (anon key is public by design;
# row-level security protects data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
